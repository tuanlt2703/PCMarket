# Copy to .env and replace these values. Do not commit the real .env file.
# General secret key
APP_PORT = 8080

# PostgresDB secret keys
# PostgreSQL admin account (local development only)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
POSTGRES_PORT=5432

# Product service runtime account
PRODUCT_DB_PASSWORD=replace-with-a-different-long-random-password
# Product service migration account
PRODUCT_MIGRATOR_PASSWORD=replace-with-a-separate-long-random-migrator-password

